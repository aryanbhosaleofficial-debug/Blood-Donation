# Community Blood Donation Matching System - environment configuration
#
# Copy this file to `.env` and adjust values for your machine:
#     cp .env.example .env
#
# `npm start` will create `.env` automatically (with a generated SESSION_SECRET)
# if one does not exist yet.
#
# Every variable read by backend/src/core/config.js is documented here.
# No other part of the application reads process.env directly.

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# HTTP port the backend listens on.
PORT=3000

# --- Application origin & locale -------------------------------------------
# Browser origin the app is served from. Used later for CSRF/Origin checks.
APP_ORIGIN=http://localhost:3000
# IANA timezone used for UI formatting and local-hour surge buckets.
APP_TIMEZONE=Asia/Kolkata
# Log verbosity: silent | error | warn | info | debug
LOG_LEVEL=info

# --- Security --------------------------------------------------------------
# REQUIRED. Secret used to sign session cookies (added in Phase 1).
# Must be at least 16 characters and must not be the literal "replace-me".
SESSION_SECRET=replace-me

# --- Database -------------------------------------------------------------
# SQLite database file (relative paths are resolved from the repo root).
DATABASE_PATH=./data/app.db
# Session store database file (used from Phase 1 onward).
SESSION_DATABASE_PATH=./data/sessions.db
# SQLite busy_timeout in milliseconds.
DB_BUSY_TIMEOUT_MS=5000

# --- Domain policy (used by later phases) --------------------------------
# How long an emergency request stays OPEN before it expires.
REQUEST_TTL_MINUTES=120
# How long a temporary donor location session lives.
LOCATION_SESSION_TTL_MINUTES=30
# After this many days a donor's AVAILABLE status is treated as UNKNOWN.
AVAILABILITY_FRESHNESS_DAYS=7
# Maximum delivery attempts for an outbound notification.
NOTIFICATION_MAX_ATTEMPTS=3
# Dashboard polling interval hint for the frontend.
POLL_INTERVAL_MS=3000

# --- Surge detection thresholds (used by later phases) ------------------
SURGE_PROBABILITY_THRESHOLD=0.01
SURGE_MINIMUM_COUNT=5
SURGE_LEVEL2_SCORE=40
SURGE_LEVEL3_SCORE=70
