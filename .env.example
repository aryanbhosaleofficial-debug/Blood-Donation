# Community Blood Donation Matching System - environment configuration
#
# Copy this file to `.env` and adjust values for your machine:
#     cp .env.example .env
#
# `npm start` creates `.env` automatically (with a generated SESSION_SECRET)
# if one does not exist yet.
#
# Every variable read by backend/src/core/config.js is documented here.
# No other part of the application reads process.env directly.

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# HTTP port the backend listens on.
PORT=3000

# --- Application origin & locale -----------------------------------------
# Browser origin the backend accepts requests from. State-changing requests must
# send a matching Origin/Referer (CSRF defence).
APP_ORIGIN=http://localhost:3000
# Browser origin for the React / Vite frontend development server.
FRONTEND_ORIGIN=http://localhost:5173
# IANA timezone used for UI formatting and local-hour surge buckets.
APP_TIMEZONE=Asia/Kolkata
# Log verbosity: silent | error | warn | info | debug
LOG_LEVEL=info

# --- Sessions & security ------------------------------------------------
# REQUIRED. Secret used to sign the session cookie.
# Must be >= 16 characters and must not be the literal "replace-me".
SESSION_SECRET=replace-with-a-long-random-secret
# Session lifetime in hours (cookie maxAge + server expiry).
SESSION_MAX_AGE_HOURS=4
# Set to true only when running behind a trusted reverse proxy (enables
# "trust proxy" so secure cookies + client IPs work correctly).
TRUST_PROXY=false
# Maximum accepted JSON request body size.
JSON_BODY_LIMIT=100kb
# bcrypt work factor (4-15). 12 is the recommended default.
BCRYPT_ROUNDS=12

# --- Login brute-force / rate limiting --------------------------------
# Per-account: lock after this many consecutive failures...
LOGIN_MAX_ATTEMPTS=5
# ...for this many minutes.
LOGIN_LOCK_MINUTES=15
# Per-IP login rate limit (generous: shared campus IPs). Account lockout is
# the primary control.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=50

# --- Database ---------------------------------------------------------
# SQLite database file (relative paths resolve from the repo root).
DATABASE_PATH=./data/app.db
# Session store database file (used when NODE_ENV != test).
SESSION_DATABASE_PATH=./data/sessions.db
# SQLite busy_timeout in milliseconds.
DB_BUSY_TIMEOUT_MS=5000

# --- Module 02 inventory UX/application bounds -----------------------
# Prototype sanity bound; not a medical standard.
INVENTORY_MAX_UNITS=1000
# Age after which recorded inventory is shown as stale; not a guarantee of stock.
INVENTORY_STALE_MINUTES=30

# --- Module 03 emergency requests ---------------------------------
# How long a new request stays OPEN before it is considered expired.
REQUEST_TTL_MINUTES=120
# Application safety bound on units per request; not a medical standard.
REQUEST_MAX_UNITS=20
# Server-set potential-donor coordination backup slots per request.
REQUEST_BACKUP_SLOTS_DEFAULT=0

# --- Donor matching, temporary location, and ETA --------------------
LOCATION_SESSION_TTL_MINUTES=30
AVAILABILITY_FRESHNESS_DAYS=7
# Approximate donor-profile discovery settings; logistics/demo values, not medical rules.
DONOR_DISCOVERY_RADIUS_KM=25
DONOR_MATCH_LIMIT=50
# Prototype logistics assumptions for coarse potential-donor ETA bands.
ETA_ROAD_FACTOR=1.3
ETA_ASSUMED_SPEED_KMH=25
ETA_PREP_BUFFER_MINUTES=5
# --- Module 07 notification worker ----------------------------------------
# How often the worker polls for QUEUED notifications (milliseconds).
NOTIFICATION_WORKER_INTERVAL_MS=1000
# Maximum notifications processed per worker tick.
NOTIFICATION_WORKER_BATCH_SIZE=25
# Maximum delivery attempts before a notification is marked FAILED.
NOTIFICATION_MAX_ATTEMPTS=3
# Base retry backoff (formula: base * 2^attempt ms).
NOTIFICATION_RETRY_BASE_MS=5000
# React frontend polling interval for unread badge (milliseconds).
POLL_INTERVAL_MS=3000

# --- Surge detection thresholds (legacy scaffold keys) ------------
SURGE_PROBABILITY_THRESHOLD=0.01
SURGE_MINIMUM_COUNT=5
SURGE_LEVEL2_SCORE=40
SURGE_LEVEL3_SCORE=70

# --- Module 09 surge detection ------------------------------------
# Module 09 detects UNUSUAL blood-demand patterns for admin review.
# It does NOT predict disasters and never auto-confirms a surge.
# How often the surge detector job runs (milliseconds).
SURGE_DETECTOR_INTERVAL_MS=60000
# Recent demand window analysed each pass (minutes).
SURGE_ANALYSIS_WINDOW_MINUTES=60
# Poisson upper-tail probability below which demand is "statistically unusual".
SURGE_P_VALUE_THRESHOLD=0.01
# Minimum observed requests in the window before a candidate can be raised.
SURGE_MIN_REQUEST_COUNT=5
# Distinct requesting hospitals that count as stronger distribution evidence.
SURGE_MIN_DISTINCT_HOSPITALS=2
# Requesting hospitals within this radius count as geographically concentrated.
SURGE_GEO_RADIUS_KM=15
# Minimum days of real request history before REAL-mode statistics are trusted.
SURGE_MIN_BASELINE_DAYS=7
# How often the real baseline is regenerated (milliseconds).
SURGE_BASELINE_REFRESH_INTERVAL_MS=21600000
# UI-only hint: score at/above which the dashboard highlights a candidate.
# It never auto-confirms.
SURGE_SCORE_CONFIRMATION_HINT=70

# --- Module 08 cleanup jobs -----------------------------------------
# How often the request expiry job runs (milliseconds).
REQUEST_EXPIRY_JOB_INTERVAL_MS=60000
# Maximum requests expired per job tick.
REQUEST_EXPIRY_BATCH_SIZE=50
# How often the location cleanup job runs (milliseconds).
LOCATION_CLEANUP_INTERVAL_MS=60000
# Maximum expired location sessions deleted per job tick.
LOCATION_CLEANUP_BATCH_SIZE=100
